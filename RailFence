import java.util.Scanner;
public class RailFence {
    static String encrypt(String text, int rails) {
        String result = "";
        for (int r = 0; r < rails; r++) {
            for (int i = r; i < text.length(); i += 2 * (rails - 1)) {
                result += text.charAt(i);
                int j = i + 2 * (rails - r - 1);
                if (r!= 0 && r!= rails - 1 && j < text.length())
                    result += text.charAt(j); }}
        return result; }
    static String decrypt(String cipher, int rails) {
        char[] result = new char[cipher.length()];
        boolean[] used = new boolean[cipher.length()];
        int index = 0;
        for (int r = 0; r < rails; r++) {
            for (int i = r; i < cipher.length(); i += 2 * (rails - 1)) {
                result[i] = cipher.charAt(index++);
                used[i] = true;
                int j = i + 2 * (rails - r - 1);
                if (r!= 0 && r!= rails - 1 && j < cipher.length()) {
                    result[j] = cipher.charAt(index++);
                    used[j] = true; }}}
        return new String(result); }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter message: ");
        String text = sc.nextLine().replace(" ", "");
        System.out.print("Enter number of rails: ");
        int rails = sc.nextInt();
        String encrypted = encrypt(text, rails);
        System.out.println("Encrypted Message: " + encrypted);
        String decrypted = decrypt(encrypted, rails);
        System.out.println("Decrypted Message: " + decrypted);
        sc.close();}}
