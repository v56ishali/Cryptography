public static void main(String[] args) {
        PlayfairCipherApp app = new PlayfairCipherApp();
        Scanner scanner = new Scanner(System.in);
        
        System.out.println("=========================================");
        System.out.println("🔒 Playfair Cipher Secret Message App 🔒");
        System.out.println("=========================================");

        System.out.print("Enter custom Secret Key (e.g., SECRET): ");
        String key = scanner.nextLine().trim();
        if (key.isEmpty()) {
            key = "KEYWORD";
            System.out.println("No key provided. Defaulting to: '" + key + "'");
        }

        app.generateMatrix(key);
        app.printMatrix();

        while (true) {
            System.out.println("\nChoose an Action:");
            System.out.println("1. Encrypt a Message");
            System.out.println("2. Decrypt a Message");
            System.out.println("3. View Matrix Grid");
            System.out.println("4. Exit App");
            System.out.print("Select choice (1-4): ");
            
            String choice = scanner.nextLine().trim();

            if (choice.equals("1")) {
                System.out.print("Enter plaintext to encrypt: ");
                String msg = scanner.nextLine();
                System.out.println("\n🔐 [Ciphertext Output]: " + app.transform(msg, "encrypt"));
            } else if (choice.equals("2")) {
                System.out.print("Enter ciphertext to decrypt: ");
                String cipher = scanner.nextLine();
                System.out.println("\n🔓 [Plaintext Output]: " + app.transform(cipher, "decrypt"));
                System.out.println("*(Note: Look for tracking 'X' padding values or combined I/J conversions)");
            } else if (choice.equals("3")) {
                app.printMatrix();
            } else if (choice.equals("4")) {
                System.out.println("\nExiting Secret Message App. Keep your data safe!");
                break;
            } else {
                System.out.println("Invalid selection. Try again.");
            }
        }
        scanner.close();
    }
}
